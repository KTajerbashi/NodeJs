{
  "name": "full-stack-app",
  "version": "1.0.0",
  "private": true,
  "description": "A full-stack application built with React, Node.js, Express, MongoDB, and Docker.",
  "keywords": [
    "react",
    "node",
    "express",
    "mongodb",
    "mongoose",
    "docker",
    "full-stack"
  ],
  "homepage": "https://github.com/KTajerbashi/NodeJs#readme",
  "bugs": {
    "url": "https://github.com/KTajerbashi/NodeJs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KTajerbashi/NodeJs.git"
  },
  "license": "MIT",
  "author": "tajerbashi",
  "scripts": {
    "start": "concurrently --raw \"npm --prefix ./client run start\" \"npm --prefix ./server run dev\"",
    "start:client": "npm --prefix ./client run start",
    "start:server": "npm --prefix ./server run dev",
    "build": "npm --prefix ./server run build && npm --prefix ./client run build",
    "start:prod": "concurrently --raw \"npm --prefix ./client run preview\" \"npm --prefix ./server run start\""
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
